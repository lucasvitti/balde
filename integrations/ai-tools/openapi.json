{
  "openapi": "3.1.0",
  "info": {
    "title": "Balde de conhecimento — Skills API",
    "description": "Read the governed OKF skills corpus, execute its governed DuckDB queries, and contribute new context to its human-curation queue. Bearer-authenticated machine API.",
    "version": "1.3.1"
  },
  "servers": [
    {
      "url": "https://balde.example.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/skills": {
      "get": {
        "operationId": "listSkills",
        "summary": "List canonical skills",
        "description": "Returns the approved/canonical skills (OKF summaries: id, title, description, tags, version). Drafts are not exposed.",
        "responses": {
          "200": {
            "description": "The list of canonical skills.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string"
                    },
                    "generatedAt": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SkillSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/skills/{id}": {
      "get": {
        "operationId": "getSkill",
        "summary": "Get one skill's full context",
        "description": "Returns the full OKF detail for a canonical skill, including objective, scope, evaluation cases, and the complete SKILL.md markdown.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The skill id (e.g. \"resumo-reuniao\").",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The skill detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Skill not found or not canonical."
          }
        }
      }
    },
    "/api/v1/skills/{id}/context": {
      "get": {
        "operationId": "listSkillContext",
        "summary": "List a skill's context files (manifest)",
        "description": "Returns the manifest of a skill's context files — path, size, kind and a one-line summary — WITHOUT their content. Use for large skills to see what's available, then fetch individual files on demand.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The skill id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The context manifest.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "skill": {
                      "type": "string"
                    },
                    "entry": {
                      "type": "object",
                      "description": "The SKILL.md root node (OKF index) — its links are the entry edges into the graph.",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "dangling": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContextManifestEntry"
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "bytes": {
                            "type": "integer"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "backlinks": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Context files that link TO this (binary) node."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Skill not found or not canonical."
          }
        }
      }
    },
    "/api/v1/skills/{id}/context/{path}": {
      "get": {
        "operationId": "readSkillContextFile",
        "summary": "Get one context file's full text",
        "description": "Downloads a single context file's full text by its path (from the manifest). Page in only the context you need instead of loading everything.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The skill id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "The context file path from the manifest (e.g. \"referencias/fontes-de-dados.md\"). Slashes allowed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The context file.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ContextFile"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "skill": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Skill not found, or path is not a readable text context file."
          }
        }
      }
    },
    "/api/v1/skills/{id}/query-run": {
      "get": {
        "operationId": "runSkillQuery",
        "summary": "Execute one of the skill's governed queries",
        "description": "Runs a stored, git-versioned .sql file of the skill (never arbitrary SQL) in an ephemeral, locked DuckDB sandbox over the skill's governed datasets — its analytics/ + data/ .csv/.parquet files plus linked capsules' data/ files, each pre-loaded as a table named by the file stem (base.parquet → table `base`). The LAST SELECT in the file is the result; rows are capped.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The skill id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "The .sql file path inside the skill (e.g. \"query/reunioes-vs-decisoes.sql\").",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The query result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "skill": {
                      "type": "string"
                    },
                    "sql": {
                      "type": "string",
                      "description": "The executed .sql path."
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Result rows (capped)."
                    },
                    "rowCount": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "elapsedMs": {
                      "type": "integer"
                    },
                    "datasets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "table": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "bytes": {
                            "type": "integer"
                          }
                        }
                      },
                      "description": "The tables pre-loaded into the sandbox and the corpus files behind them."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not a .sql file, datasets over the execution size limit, or the query failed (body carries the sandbox error)."
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Skill not found, or path is not a file of this skill."
          }
        }
      }
    },
    "/api/v1/skills/{id}/data-inspect": {
      "get": {
        "operationId": "inspectSkillDataset",
        "summary": "Profile one governed dataset of the skill",
        "description": "Returns the schema (column names + types), row count and a per-column profile (nulls, distincts, min/max) of one .csv/.parquet under the skill's analytics/ or data/ — computed in the same locked DuckDB sandbox, no SQL required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The skill id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "The dataset path inside the skill (e.g. \"analytics/reunioes.csv\" or \"data/base.parquet\").",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The dataset profile.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "skill": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "table": {
                      "type": "string",
                      "description": "The table name this file gets in a query sandbox."
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "DESCRIBE output — column names and types."
                    },
                    "rowCount": {
                      "type": "integer"
                    },
                    "profile": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "SUMMARIZE output — per-column nulls, distincts, min/max."
                    },
                    "elapsedMs": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not a .csv/.parquet file, or the profile failed."
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Skill not found, or path is not a file of this skill."
          }
        }
      }
    },
    "/api/v1/commons": {
      "get": {
        "operationId": "listCommons",
        "summary": "List shared commons concepts",
        "description": "Returns the shared 'commons' concepts (schema dictionaries, glossaries, business definitions) that any skill can link — each with its folder path, a one-line summary, which skills reference it, and media counts. No content.",
        "responses": {
          "200": {
            "description": "The list of commons concepts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "commons": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CommonsSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/commons/{path}": {
      "get": {
        "operationId": "readCommonsConcept",
        "summary": "Get one commons concept",
        "description": "Downloads one shared commons concept by its folder path (e.g. \"dados_vendas/dicionario_dados\"; also accepts a \"/commons/...\" link target). `content` INCLUDES AI-described media (image descriptions + tables rendered as markdown), so the whole concept comes back as text, plus its outbound links.",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "The commons concept folder path (slashes allowed).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ],
        "responses": {
          "200": {
            "description": "The commons concept.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonsConcept"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Commons concept not found."
          }
        }
      }
    },
    "/api/v1/queue": {
      "post": {
        "operationId": "contributeContext",
        "summary": "Contribute new context to a skill's curation queue",
        "description": "Submits new context for an existing skill into the human-curation queue. Does NOT modify the skill — a curator reviews and merges it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "skill",
                  "content"
                ],
                "properties": {
                  "skill": {
                    "type": "string",
                    "description": "The existing skill id to attach the context to."
                  },
                  "content": {
                    "type": "string",
                    "description": "The context/knowledge to contribute."
                  },
                  "title": {
                    "type": "string",
                    "description": "Optional short title."
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Optional tags."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Queued as a pending contribution.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "skillId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (e.g. skill does not exist)."
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/capsule/spec": {
      "get": {
        "operationId": "getCapsuleSpec",
        "summary": "Get the capsule authoring spec (markdown)",
        "description": "Returns the balde-capsule/1 authoring specification as raw markdown — the contract for import capsules (a JSON manifest packaging an anchor skill + shared capsule concepts + governance + timeline série/período + links). Read it BEFORE generating a manifest. WRITING STANDARD — applies to every capsule concept AND the anchor skill: write self-contained knowledge for an independent human reader who never saw the source study; open with what it is and why it matters, define terms in plain language, carry enough context to be understood cold — never terse model/API-style documentation. The loop is: spec → generate → compile → fix → repeat until ok:true → submit.",
        "responses": {
          "200": {
            "description": "The spec document.",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/capsule/categories": {
      "get": {
        "operationId": "listCapsuleCategories",
        "summary": "List the governed capsule categories (types)",
        "description": "The capsule-category vocabulary of the active balde — every capsule is one of these types (defaults: dado = closed data point, reuniao = meeting summary, decisao = decision record, tarefas = task list; admins can extend it, so read the live list instead of assuming). Set \"categoria\" on every NEW concept in a manifest with one of the keys BEFORE compiling; when the raw material does not clearly match one type, ASK the end user which fits — a create without categoria compiles with the warning categoria-ausente and lands as the default type.",
        "responses": {
          "200": {
            "description": "The vocabulary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "hint": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "default": {
                      "type": "string",
                      "description": "The key a capsule gets when \"categoria\" is omitted."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/capsule/compile": {
      "post": {
        "operationId": "compileCapsule",
        "summary": "Compile (validate) a capsule manifest — writes nothing",
        "description": "Statelessly validates a balde-capsule/1 manifest against the corpus. The report's `repo` field and first plan line (`balde: <name>`) echo the TARGET balde this compile ran against (the ?repo= param; unset = corporate) — show it to the user so the knowledge lands in the right balde. The manifest may optionally pin `\"repo\": \"<name>\"` as an assertion: compile fails with repo-divergente when it doesn't match. Also returns machine-readable errors ({code, path, message}) to feed back to the model, non-blocking warnings (categoria-ausente = a new capsule missing its TYPE — set \"categoria\" from listCapsuleCategories, asking the end user when unclear), and the deployment plan (episode lines include the série's current latest período). Iterate until ok:true.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "The complete balde-capsule/1 manifest (format, skill?, concepts?, references?)."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The compile report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapsuleCompileReport"
                }
              }
            }
          },
          "400": {
            "description": "Body is not valid JSON or too large."
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/capsule/submit": {
      "post": {
        "operationId": "submitCapsule",
        "summary": "Submit a clean capsule to the curation queue",
        "description": "Re-compiles the manifest server-side; a clean capsule becomes ONE curation-queue item whose approval by a human curator applies it to the corpus (concepts + governance + SKILL.md links, git-versioned). The item lands in the Fila of the target balde (?repo=; echoed by compile) — confirm that target with the user before submitting. Nothing is applied directly. Requires read access to the anchor skill. Call only after the user confirmed the compile plan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "The same balde-capsule/1 manifest that compiled clean."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Queued for curation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "submitted": {
                      "type": "boolean"
                    },
                    "queueId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CapsuleIssue"
                      }
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "The manifest did not compile — the compile report comes back with submitted: false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapsuleCompileReport"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "description": "Anchor skill not readable by this token."
          }
        },
        "parameters": [
          {
            "name": "repo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Repo (balde) a operar — partição independente do corpus (padrão: \"corporate\"). Membros apenas; não-membro recebe 404. Liste os seus em GET /api/v1/repos."
          }
        ]
      }
    },
    "/api/v1/repos": {
      "get": {
        "operationId": "listRepos",
        "summary": "Lista os repos (baldes) que a chave pode ler",
        "description": "Partições independentes do corpus (ex.: corporate vs espaço pessoal). Toda operação roda dentro de UM repo, escolhido pelo parâmetro ?repo= (padrão corporate).",
        "responses": {
          "200": {
            "description": "Lista de repos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "active": {
                      "type": "string"
                    },
                    "repos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "titulo": {
                            "type": "string"
                          },
                          "profile": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files": {
      "get": {
        "operationId": "findFiles",
        "summary": "Search downloadable attachments (files/ sidecar) across skills and capsules",
        "description": "Searches file-assets attached to skills and commons capsules (PDFs, spreadsheets, zips). These files are NOT part of the context index, so this is how an assistant discovers a document without knowing which skill or capsule owns it. ACL-aware: only files the key's owner can read are returned. Each hit has path, name, size, kind (skill|capsule), id, url (download with this key) and webUrl (SSO link for a human).",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search terms: document/plan code, file name, or part of the owning capsule id (e.g. \"40812\")."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Max results (default 20)."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching attachments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "query": {
                      "type": "string"
                    },
                    "found": {
                      "type": "integer"
                    },
                    "showing": {
                      "type": "integer"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "webUrl": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SkillSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "SkillDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SkillSummary"
          },
          {
            "type": "object",
            "properties": {
              "objetivo": {
                "type": "string"
              },
              "escopo": {
                "type": "string"
              },
              "modelTier": {
                "type": "string"
              },
              "evals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "descricao": {
                      "type": "string"
                    },
                    "mustRefuse": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "markdown": {
                "type": "string"
              },
              "context": {
                "type": "array",
                "description": "Every text context file inlined (Catálogo, queries, additional context, schema).",
                "items": {
                  "$ref": "#/components/schemas/ContextFile"
                }
              },
              "contextSkipped": {
                "type": "array",
                "description": "Context files NOT inlined (binaries without a text sidecar, oversized).",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ContextManifestEntry": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "description": "catalogo | query | contexto | schema | eval | outro"
          },
          "summary": {
            "type": "string",
            "description": "One-line summary of the file."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "OKF cross-references (markdown links) to other context files, resolved to their paths."
          },
          "backlinks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Context files that link TO this one."
          },
          "dangling": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Link targets that don't resolve to a node (tolerated per OKF)."
          }
        }
      },
      "ContextFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Outbound OKF links to other context files (for graph traversal)."
          },
          "dangling": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Unresolved link targets (tolerated per OKF)."
          }
        }
      },
      "CommonsSummary": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The concept folder path."
          },
          "summary": {
            "type": "string"
          },
          "referencedBy": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skill ids that reference this concept."
          },
          "media": {
            "type": "object",
            "description": "Counts of embedded media (e.g. { img, data })."
          }
        }
      },
      "CommonsConcept": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Full concept text, with AI-described media (image descriptions + tables as markdown) inlined."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Outbound links to other commons/skill context."
          }
        }
      },
      "CapsuleIssue": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable issue code (e.g. conceito-ja-existe, periodo-invalido)."
          },
          "path": {
            "type": "string",
            "description": "Where in the manifest (e.g. concepts[0].id)."
          },
          "message": {
            "type": "string",
            "description": "Human/AI-readable explanation with the fix."
          }
        }
      },
      "CapsuleCompileReport": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "repo": {
            "type": "string",
            "description": "The balde (repo) this compile ran against — where approval will deploy."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapsuleIssue"
            },
            "description": "Blocking — fix and recompile."
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapsuleIssue"
            },
            "description": "Non-blocking, but read them."
          },
          "plan": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The deployment preview (what approval will do)."
          }
        }
      }
    }
  }
}
